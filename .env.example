DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-to-a-real-secret-key
DATABASE_URL=postgis://farmsteader:devpassword@localhost:5432/farmsteader
REDIS_URL=redis://localhost:6379/0
USDA_NASS_API_KEY=

# --- Production only -------------------------------------------------------
# Everything below is read by config/settings/prod.py and ignored in dev.
#
# DJANGO_SETTINGS_MODULE must be set in the process environment, not just here:
# django-environ reads this file from inside base.py, by which point the
# settings module has already been chosen. systemd's EnvironmentFile= does set
# the real environment, so a production install is fine.

# Comma-separated. Required in prod -- the app will not start without it.
#ALLOWED_HOSTS=farm.example.com,192.168.1.50,localhost,127.0.0.1

# Scheme-qualified, unlike ALLOWED_HOSTS. Needed for admin/form POSTs.
#CSRF_TRUSTED_ORIGINS=https://farm.example.com

# The single TLS switch. Leave unset for a plain-HTTP LAN install: turning it on
# without HTTPS actually terminating in front makes every request redirect-loop.
# Enabling it turns on SSL redirect, HSTS, and secure session/CSRF cookies.
#FARMSTEADER_HTTPS=1

# Set to 0 only if the app is exposed with no reverse proxy in front, where a
# client could forge X-Forwarded-Proto to make Django believe it is on HTTPS.
#USE_PROXY_SSL_HEADER=1

# Shown as a "Source" link in the sidebar footer; no link is rendered if unset.
# FarmSteader is AGPL-3.0: if you MODIFY it and run it as a network service, you
# must offer your users the source of your modified version -- so point this at
# your own fork, not at upstream. Running it unmodified places no obligation on
# you, and setting it to upstream (below) is then a courtesy.
#FARMSTEADER_SOURCE_URL=https://github.com/mcbriderc/farmsteader

# Keep uploads and collected static outside the code directory so an upgrade can
# replace /opt/farmsteader wholesale.
#MEDIA_ROOT=/var/lib/farmsteader/media
#STATIC_ROOT=/var/lib/farmsteader/static

# Persistent database connections. Defaults to 60s in prod, 0 elsewhere.
#CONN_MAX_AGE=60

#LOG_LEVEL=INFO

# Optional error reporting. No DSN means sentry-sdk is never imported.
#SENTRY_DSN=
#SENTRY_ENVIRONMENT=production
#SENTRY_TRACES_SAMPLE_RATE=0.0
