# Settings for deploy/container/compose.yaml. Copy to .env beside it.

# Required. Generate each with:  od -An -tx1 -N32 /dev/urandom | tr -d ' \n'
# Keep DB_PASSWORD hex: it goes into a database URL, where symbols need escaping.
# It only takes effect when the database is first created.
SECRET_KEY=
DB_PASSWORD=

# Hostnames and IPs you will open FarmSteader by, comma-separated. localhost
# always works; add this machine's address to reach it from other computers.
#ALLOWED_HOSTS=192.168.1.50,farm.example.com

# Port on this machine. Use 127.0.0.1:8000 to accept local connections only.
#FARMSTEADER_PORT=8000

# Pin a release instead of following the newest one, e.g. 0.8.0.
#FARMSTEADER_VERSION=latest

# Behind a reverse proxy that terminates HTTPS, set all three. Leave them alone
# for plain HTTP: the first would make every request redirect in a loop, and the
# second lets any client fake HTTPS when no proxy overwrites that header.
#FARMSTEADER_HTTPS=1
#USE_PROXY_SSL_HEADER=1
#CSRF_TRUSTED_ORIGINS=https://farm.example.com

# Optional integrations.
#USDA_NASS_API_KEY=
#SENTRY_DSN=

# Sizing. Each web worker uses about 130 MB.
#GUNICORN_WORKERS=2
#CELERY_CONCURRENCY=2

# AGPL "Source" link. If you modify FarmSteader, point this at your own fork.
#FARMSTEADER_SOURCE_URL=https://github.com/mcbriderc/farmsteader
