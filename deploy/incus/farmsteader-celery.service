[Unit]
Description=FarmSteader Celery Worker
After=network.target redis-server.service
Requires=redis-server.service

[Service]
Type=forking
User=farmsteader
Group=farmsteader
WorkingDirectory=/opt/farmsteader
EnvironmentFile=/opt/farmsteader/.env
ExecStart=/opt/farmsteader/.venv/bin/celery -A config multi start worker \
    --pidfile=/run/farmsteader/celery-%%n.pid \
    --logfile=/var/log/farmsteader/celery-%%n.log \
    --loglevel=info \
    --concurrency=2
ExecStop=/opt/farmsteader/.venv/bin/celery -A config multi stopwait worker \
    --pidfile=/run/farmsteader/celery-%%n.pid
ExecReload=/opt/farmsteader/.venv/bin/celery -A config multi restart worker \
    --pidfile=/run/farmsteader/celery-%%n.pid \
    --logfile=/var/log/farmsteader/celery-%%n.log \
    --loglevel=info \
    --concurrency=2
RuntimeDirectory=farmsteader
LogsDirectory=farmsteader
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
