[Unit]
Description=FarmSteader Gunicorn
After=network.target postgresql.service redis-server.service
Requires=postgresql.service

[Service]
Type=notify
User=farmsteader
Group=farmsteader
RuntimeDirectory=farmsteader
WorkingDirectory=/opt/farmsteader
EnvironmentFile=/opt/farmsteader/.env
ExecStart=/opt/farmsteader/.venv/bin/gunicorn config.wsgi:application -c /opt/farmsteader/deploy/incus/gunicorn.conf.py
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5
KillMode=mixed
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
